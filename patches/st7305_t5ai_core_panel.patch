+    3,  0,   0xD6, 0x17, 0x02,                                                 // NVM Load Control
+    2,  0,   0xD1, 0x01,                                                       // Booster Enable
+    3,  0,   0xC0, 0x11, 0x04,                                                 // Gate Voltage Setting
+    5,  0,   0xC1, 0x69, 0x69, 0x69, 0x69,                                     // VSHP Setting
+    5,  0,   0xC2, 0x19, 0x19, 0x19, 0x19,                                     // VSLP Setting
+    5,  0,   0xC4, 0x4B, 0x4B, 0x4B, 0x4B,                                     // VSHN Setting
+    5,  0,   0xC5, 0x19, 0x19, 0x19, 0x19,                                     // VSLN Setting
+    3,  0,   0xD8, 0x80, 0xE9,                                                 // OSC Setting
+    2,  0,   0xB2, 0x02,                                                       // Frame Rate Control
+    11, 0,   0xB3, 0xE5, 0xF6, 0x05, 0x46, 0x77, 0x77, 0x77, 0x77, 0x76, 0x45, // Update Period Gate
+    9,  0,   0xB4, 0x05, 0x46, 0x77, 0x77, 0x77, 0x77, 0x76, 0x45,             // Update Period Gate LPM
+    4,  0,   0x62, 0x32, 0x03, 0x1F,                                           // Gate Timing Control
+    2,  0,   0xB7, 0x13,                                                       // Source EQ Enable
+    2,  0,   0xB0, 0x64,                                                       // Gate Line Setting 400/4
+    1,  200, 0x11,                                                             // Sleep out
+    2,  0,   0xC9, 0x00,                                                       // Source Voltage Select
